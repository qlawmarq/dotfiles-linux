{
  "mcpServers": {
    "chrome-devtools": {
      "command": "{{NPX}}",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "context7": {
      "command": "{{NPX}}",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "playwright": {
      "command": "{{NPX}}",
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  }
}
